---
import InstallAppButton from "@/components/pwa/InstallAppButton.astro";

const { user } = Astro.locals;
---

<div
  class="mb-4 flex flex-col gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white/80 sm:flex-row sm:items-center sm:justify-between sm:py-2"
>
  {
    user ? (
      <>
        <span class="min-w-0 truncate text-blue-100/70">{user.email}</span>
        <div class="flex shrink-0 items-center gap-3">
          <InstallAppButton />
          <a
            href="/dashboard"
            class="rounded-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-200"
          >
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-200"
            >
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex shrink-0 gap-3">
          <InstallAppButton />
          <a
            href="/auth/signin"
            class="rounded-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-200"
          >
            Sign in
          </a>
          <a
            href="/auth/signup"
            class="rounded-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-200"
          >
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
