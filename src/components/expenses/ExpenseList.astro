---
import type { ExpenseDisplay } from "@/lib/expense-balance";
import DeclineExpenseDialog from "@/components/expenses/DeclineExpenseDialog.astro";
import EditExpenseDialog from "@/components/expenses/EditExpenseDialog.astro";
import DeleteExpenseDialog from "@/components/expenses/DeleteExpenseDialog.astro";

interface Props {
  expenses: readonly ExpenseDisplay[];
  children: readonly { id: string; name: string }[];
  month: string;
  maxDate: string;
  currentMembershipId: string | null;
  canApprove: boolean;
  isMonthLocked: boolean;
  refreshTarget?: string;
}

const {
  expenses,
  children,
  month,
  maxDate,
  currentMembershipId,
  canApprove,
  isMonthLocked,
  refreshTarget = "/dashboard",
} = Astro.props;
const activeExpenses = expenses.filter((expense) => expense.status !== "declined");
const declinedExpenses = expenses.filter((expense) => expense.status === "declined");
const canEditExpense = (expense: ExpenseDisplay) =>
  Boolean(currentMembershipId && expense.payerId === currentMembershipId && !isMonthLocked);
const canReviewExpense = (expense: ExpenseDisplay) =>
  Boolean(
    canApprove &&
    currentMembershipId &&
    expense.status === "pending" &&
    expense.payerId !== currentMembershipId &&
    !isMonthLocked,
  );
const canDeleteExpense = (expense: ExpenseDisplay) =>
  Boolean(
    currentMembershipId && expense.payerId === currentMembershipId && !isMonthLocked && expense.status !== "approved",
  );
---

<section id="expense-list-container" class="mt-6">
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-lg font-semibold">Expenses</h2>
    <form data-refresh-expenses method="GET" action={refreshTarget} class="flex flex-col items-end">
      <input type="hidden" name="month" value={month} />
      <button type="submit" class="rounded-lg border border-white/20 px-3 py-1 text-sm hover:bg-white/10"
        >Refresh</button
      >
    </form>
  </div>
  <ul id="expense-list" class="mt-3 space-y-3">
    {
      activeExpenses.map((expense) => (
        <li data-expense-id={expense.id} class="rounded-xl border border-white/15 bg-white/5 p-4">
          <p data-expense-refresh-status class="mb-2 hidden items-center gap-2 text-sm text-blue-100" role="status">
            <svg aria-hidden="true" class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M21 12a9 9 0 1 1-2.64-6.36" stroke-linecap="round" stroke-width="2" />
              <path d="M21 3v6h-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
            </svg>
            Refreshing expense…
          </p>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-medium">{expense.description}</p>
              {expense.isRecurring && <p class="mt-1 text-sm text-violet-200">Recurring expense</p>}
              <p class="mt-1 text-sm text-blue-100/70">
                {expense.expenseDate} · {expense.childName ?? "No specific child"}
              </p>
              {expense.payerDisplayName && (
                <p class="mt-1 text-sm text-blue-100/70">Added by {expense.payerDisplayName}</p>
              )}
            </div>
            <div class="text-right">
              <p class="font-semibold">{expense.amountPln} PLN</p>
              {expense.status === "approved" ? (
                <p class="mt-1 text-sm text-emerald-200">Approved</p>
              ) : canReviewExpense(expense) ? (
                <div data-review-actions class="mt-2 grid grid-cols-2 items-start justify-end gap-2">
                  <form data-approve-expense method="POST" action="/api/expenses/approve">
                    <input type="hidden" name="expenseId" value={expense.id} />
                    <input type="hidden" name="month" value={month} />
                    <button
                      type="submit"
                      class="rounded-lg bg-emerald-600 px-3 py-1 text-sm font-medium hover:bg-emerald-500"
                    >
                      Approve
                    </button>
                  </form>
                  <DeclineExpenseDialog
                    expenseId={expense.id}
                    month={month}
                    previousReason={expense.previousDeclineReason}
                  />
                </div>
              ) : !canEditExpense(expense) ? (
                <p class="mt-1 text-sm text-amber-200">Awaiting review</p>
              ) : null}
              {canEditExpense(expense) && (
                <div class="mt-2 flex justify-end gap-2">
                  <EditExpenseDialog expense={expense} children={children} month={month} maxDate={maxDate} />
                  {canDeleteExpense(expense) && <DeleteExpenseDialog expenseId={expense.id} month={month} />}
                </div>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
  {
    activeExpenses.length === 0 && declinedExpenses.length === 0 && (
      <p id="empty-expense-list" class="mt-2 text-sm text-blue-100/60">
        No expenses for this month yet.
      </p>
    )
  }
  {
    declinedExpenses.length > 0 && (
      <section class="mt-8" aria-labelledby="declined-expenses-heading">
        <h3 id="declined-expenses-heading" class="text-base font-semibold text-red-100">
          Declined expenses
        </h3>
        <ul id="declined-expense-list" class="mt-3 space-y-3">
          {declinedExpenses.map((expense) => (
            <li data-expense-id={expense.id} class="rounded-xl border border-red-300/20 bg-red-500/5 p-4">
              <p data-expense-refresh-status class="mb-2 hidden items-center gap-2 text-sm text-blue-100" role="status">
                <svg
                  aria-hidden="true"
                  class="size-4 animate-spin"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path d="M21 12a9 9 0 1 1-2.64-6.36" stroke-linecap="round" stroke-width="2" />
                  <path d="M21 3v6h-6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                </svg>
                Refreshing expense…
              </p>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-medium">{expense.description}</p>
                  {expense.isRecurring && <p class="mt-1 text-sm text-violet-200">Recurring expense</p>}
                  <p class="mt-1 text-sm text-blue-100/70">
                    {expense.expenseDate} · {expense.childName ?? "No specific child"}
                  </p>
                  {expense.payerDisplayName && (
                    <p class="mt-1 text-sm text-blue-100/70">Added by {expense.payerDisplayName}</p>
                  )}
                </div>
                <div class="text-right">
                  <p class="font-semibold">{expense.amountPln} PLN</p>
                  <p class="mt-1 text-sm text-red-200">Declined</p>
                  {expense.declineReason && (
                    <p class="mt-1 text-sm text-red-100/80">
                      <span class="font-medium text-red-100">Decline reason:</span> {expense.declineReason}
                    </p>
                  )}
                  {canEditExpense(expense) && (
                    <div class="mt-2 flex justify-end gap-2">
                      <EditExpenseDialog expense={expense} children={children} month={month} maxDate={maxDate} />
                      {canDeleteExpense(expense) && <DeleteExpenseDialog expenseId={expense.id} month={month} />}
                    </div>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</section>

<script>
  import { setExpenseRefreshing } from "@/lib/expense-refresh-indicator";
  import { refreshExpenseWorkspace } from "@/lib/expense-workspace-refresh";

  interface ApprovalResult {
    error?: string;
    expenseId?: string;
    month?: string;
  }

  function getApprovalErrorContainer(form: HTMLFormElement) {
    return form.closest<HTMLElement>("[data-review-actions]") ?? form;
  }

  function showApprovalError(form: HTMLFormElement, message: string) {
    const container = getApprovalErrorContainer(form);
    const existing = container.querySelector<HTMLElement>("[role='alert']");
    if (existing) {
      existing.textContent = message;
      return;
    }
    const error = document.createElement("p");
    error.className = "col-span-full text-right text-sm text-red-200";
    error.setAttribute("role", "alert");
    error.textContent = message;
    container.append(error);
  }

  function showRefreshError(form: HTMLFormElement, message: string) {
    const existing = form.querySelector<HTMLElement>("[role='alert']");
    if (existing) {
      existing.textContent = message;
      return;
    }
    const error = document.createElement("p");
    error.className = "mt-2 text-sm text-red-200";
    error.setAttribute("role", "alert");
    error.textContent = message;
    form.append(error);
  }

  const expenseListWindow = window as typeof window & { expenseListSubmitHandlerReady?: boolean };

  if (!expenseListWindow.expenseListSubmitHandlerReady) {
    expenseListWindow.expenseListSubmitHandlerReady = true;
    document.addEventListener("submit", async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;

      if (form.matches("[data-approve-expense]")) {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
        const data = new FormData(form);
        button?.setAttribute("disabled", "true");
        if (button) button.textContent = "Approving…";
        setExpenseRefreshing(form, true);
        getApprovalErrorContainer(form).querySelector("[role='alert']")?.remove();
        let approvalSaved = false;

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: data,
          });
          const result = (await response.json()) as ApprovalResult;
          if (!response.ok || result.error || !result.expenseId || !result.month) {
            showApprovalError(form, result.error ?? "We could not approve that expense. Please try again.");
            return;
          }
          approvalSaved = true;
          await refreshExpenseWorkspace(window, result.month);
        } catch {
          showApprovalError(
            form,
            approvalSaved
              ? "The expense was approved, but the view could not refresh. Please reload the page."
              : "We could not approve that expense. Please try again.",
          );
        } finally {
          setExpenseRefreshing(form, false);
          button?.removeAttribute("disabled");
          if (button) button.textContent = "Approve";
        }
        return;
      }

      if (!form.matches("[data-refresh-expenses]")) return;
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
      form.querySelector("[role='alert']")?.remove();
      if (button) {
        button.disabled = true;
        button.textContent = "Refreshing…";
      }
      try {
        await refreshExpenseWorkspace(window, String(new FormData(form).get("month") ?? ""));
      } catch {
        showRefreshError(form, "We could not refresh expenses. Please try again.");
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = "Refresh";
        }
      }
    });
  }
</script>
