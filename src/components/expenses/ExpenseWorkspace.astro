---
import ExpenseList from "@/components/expenses/ExpenseList.astro";
import AddExpenseDialog from "@/components/expenses/AddExpenseDialog.astro";
import MonthlyBalancePanel from "@/components/expenses/MonthlyBalancePanel.astro";
import { loadExpenseWorkspaceState } from "@/lib/expense-balance";
import type { SupabaseClient } from "@supabase/supabase-js";

interface Props {
  familyId: string;
  userId: string;
  supabase: SupabaseClient | null;
  children: readonly { id: string; name: string }[];
  month: string;
  refreshTarget?: string;
  creationAvailable?: boolean;
  hideCreationWhenLocked?: boolean;
  mobileCreateHref?: string;
}

const {
  familyId,
  userId,
  supabase,
  children,
  month,
  refreshTarget = "/dashboard",
  creationAvailable = true,
  hideCreationWhenLocked = false,
  mobileCreateHref = "/expenses/new",
} = Astro.props;
const state = supabase ? await loadExpenseWorkspaceState(supabase, { familyId, userId, month }) : null;
const today = new Date().toISOString().slice(0, 10);
const currentMonth = today.slice(0, 7);
const defaultDate = today.slice(0, 7) === month ? today : `${month}-01`;
const monthLabel = new Intl.DateTimeFormat("en", { month: "long", year: "numeric", timeZone: "UTC" }).format(
  new Date(`${month}-01T00:00:00Z`),
);
---

<section class="border-t border-white/10 pt-8" data-expense-workspace data-refresh-target={refreshTarget}>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm tracking-wide text-purple-200 uppercase">Shared expenses</p>
      <h2 class="mt-1 text-2xl font-bold">{monthLabel}</h2>
    </div>
    {
      creationAvailable && !(hideCreationWhenLocked && state?.settlement.isLocked) && (
        <div>
          <AddExpenseDialog
            children={children}
            month={month}
            maxDate={today}
            defaultDate={defaultDate}
            isMonthLocked={state?.settlement.isLocked ?? false}
          />
          <a
            href={mobileCreateHref}
            class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium hover:bg-purple-500 md:hidden"
          >
            Add expense
          </a>
        </div>
      )
    }
  </div>

  <div id="monthly-balance-container" class="mt-5">
    {
      state?.balance && state.currentMembershipId && (
        <MonthlyBalancePanel
          balance={state.balance}
          activeParents={state.activeParents}
          currentMembershipId={state.currentMembershipId}
          currentMonth={currentMonth}
          month={month}
          settlement={state.settlement}
        />
      )
    }
    {
      !state?.balance && (
        <section class="rounded-xl border border-amber-300/30 bg-amber-500/10 p-4">
          <p class="text-sm tracking-wide text-amber-100 uppercase">Monthly balance</p>
          <p class="mt-3 font-medium text-amber-50">Balance unavailable</p>
          <p class="mt-1 text-sm text-amber-100/80">
            Both parents must join the family before a monthly balance is available.
          </p>
        </section>
      )
    }
  </div>
  <ExpenseList
    expenses={state?.expenses ?? []}
    children={children}
    month={month}
    maxDate={today}
    currentMembershipId={state?.currentMembershipId ?? null}
    canApprove={Boolean(state?.balance && state.currentMembershipId)}
    isMonthLocked={state?.settlement.isLocked ?? false}
    refreshTarget={refreshTarget}
  />
</section>

<script>
  async function refreshExpenseWorkspace(month: string) {
    const refreshTarget = document.querySelector<HTMLElement>("[data-expense-workspace]")?.dataset.refreshTarget;
    if (!refreshTarget) throw new Error("Unable to refresh expenses");

    const refreshUrl = new URL(refreshTarget, window.location.origin);
    refreshUrl.searchParams.set("month", month);
    const response = await fetch(`${refreshUrl.pathname}${refreshUrl.search}`);
    if (!response.ok) throw new Error("Unable to refresh expenses");

    const parsedDocument = new DOMParser().parseFromString(await response.text(), "text/html");
    const updatedBalance = parsedDocument.querySelector<HTMLElement>("#monthly-balance-container");
    const updatedList = parsedDocument.querySelector<HTMLElement>("#expense-list-container");
    if (!updatedBalance || !updatedList) throw new Error("Unable to refresh expenses");

    const currentBalance = document.querySelector<HTMLElement>("#monthly-balance-container");
    const currentList = document.querySelector<HTMLElement>("#expense-list-container");
    if (!currentBalance || !currentList) throw new Error("Unable to refresh expenses");

    currentBalance.replaceWith(updatedBalance);
    currentList.replaceWith(updatedList);
    (
      window as typeof window & {
        initializeExpenseDatePickers?: (root?: ParentNode) => void;
      }
    ).initializeExpenseDatePickers?.(updatedList);
  }

  (window as typeof window & { refreshExpenseWorkspace?: (month: string) => Promise<void> }).refreshExpenseWorkspace =
    refreshExpenseWorkspace;

  function showEditError(form: HTMLFormElement, message: string) {
    const existing = form.querySelector<HTMLElement>("[role='alert']");
    if (existing) {
      existing.textContent = message;
      return;
    }
    const error = document.createElement("p");
    error.className = "sm:col-span-2 text-sm text-red-200";
    error.setAttribute("role", "alert");
    error.textContent = message;
    form.append(error);
  }

  function setEditRefreshing(form: HTMLFormElement, isRefreshing: boolean) {
    const card = form.closest<HTMLElement>("[data-expense-id]");
    card?.toggleAttribute("aria-busy", isRefreshing);
    const status = card?.querySelector<HTMLElement>("[data-expense-refresh-status]");
    status?.classList.toggle("hidden", !isRefreshing);
    status?.classList.toggle("flex", isRefreshing);
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const editOpener = target.closest<HTMLButtonElement>("[data-open-edit]");
    if (editOpener) {
      const expenseId = editOpener.dataset.openEdit;
      const dialog = document.querySelector<HTMLDialogElement>(`[data-edit-dialog='${expenseId ?? ""}']`);
      dialog?.addEventListener("close", () => editOpener.focus(), { once: true });
      return;
    }
    const editCancel = target.closest<HTMLButtonElement>("[data-cancel-edit]");
    if (editCancel) {
      editCancel.closest<HTMLDialogElement>("dialog")?.close();
      return;
    }
    const opener = target.closest<HTMLElement>("[data-open-settlement-dialog]");
    const dialogId = opener?.dataset.openSettlementDialog;
    const dialog = dialogId ? document.getElementById(dialogId) : null;
    if (dialog instanceof HTMLDialogElement) dialog.showModal();
    if (target.matches("[data-cancel-settlement]")) target.closest("dialog")?.close();
  });

  document.addEventListener("submit", async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches("[data-edit-expense]")) return;
    event.preventDefault();
    const submitButton = form.querySelector<HTMLButtonElement>("button[type='submit']");
    submitButton?.setAttribute("disabled", "true");
    if (submitButton) submitButton.textContent = "Saving…";
    form.querySelector("[role='alert']")?.remove();
    setEditRefreshing(form, true);
    let editSaved = false;

    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      const result = (await response.json()) as { expenseId?: string; month?: string; error?: string };
      if (!response.ok || !result.expenseId || !result.month) {
        showEditError(form, result.error ?? "We could not update that expense. Please try again.");
        return;
      }
      editSaved = true;
      await refreshExpenseWorkspace(result.month);
      form.closest<HTMLDialogElement>("dialog")?.close();
    } catch {
      showEditError(
        form,
        editSaved
          ? "The expense was updated, but the view could not refresh. Please reload the page."
          : "We could not update that expense. Please try again.",
      );
    } finally {
      setEditRefreshing(form, false);
      submitButton?.removeAttribute("disabled");
      if (submitButton) submitButton.textContent = "Save changes";
    }
  });

  document.addEventListener("submit", async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches("[data-confirm-settlement]")) return;
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const error = form.querySelector<HTMLElement>("[data-settlement-error]");
    let confirmationSaved = false;
    if (error) {
      error.textContent = "";
      error.classList.add("hidden");
    }
    button?.setAttribute("disabled", "true");
    if (button) button.textContent = "Confirming…";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      const result = (await response.json()) as { error?: string; month?: string };
      if (!response.ok || result.error || !result.month)
        throw new Error(result.error ?? "We could not confirm this settlement. Please try again.");
      confirmationSaved = true;
      await refreshExpenseWorkspace(result.month);
      form.closest("dialog")?.close();
    } catch (cause) {
      if (error) {
        error.textContent = confirmationSaved
          ? "Settlement was confirmed, but the view could not refresh. Reload the page."
          : cause instanceof Error
            ? cause.message
            : "We could not confirm this settlement. Please try again.";
        error.classList.remove("hidden");
      }
    } finally {
      button?.removeAttribute("disabled");
      if (button) button.textContent = "Confirm";
    }
  });
</script>
