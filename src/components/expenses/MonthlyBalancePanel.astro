---
import type { MonthlyBalance } from "@/lib/financial-rules";
import { shouldRenderUnavailableSettlementPanel, type SettlementState } from "@/lib/expense-balance";
import SettlementConfirmationDialog from "@/components/expenses/SettlementConfirmationDialog.astro";

interface Props {
  balance: MonthlyBalance;
  currentMembershipId: string;
  month: string;
  settlement: SettlementState;
}

const { balance, currentMembershipId, month, settlement } = Astro.props;
const hasPendingExpenses = balance.toReviewAmount.greaterThan(0);
const settlementMessage =
  balance.settlement.kind === "balanced"
    ? "Your approved balance is even."
    : balance.settlement.fromParentId === currentMembershipId
      ? `You owe ${balance.settlement.amount.toFixed(0)} PLN.`
      : `You are owed ${balance.settlement.amount.toFixed(0)} PLN.`;
const confirmationMessage = balance.settlement.kind === "balanced" ? "No payment needed." : settlementMessage;
const unavailableSettlementMessage =
  settlement.kind !== "unavailable"
    ? null
    : {
        "current-month": "Settlement is available after this month ends.",
        "one-parent": "Both active parents must be in the family before a month can be settled.",
        "no-expenses": "Add at least one expense before settling this month.",
        pending: "Approve or decline every expense before settlement.",
        declined: "A declined expense must be edited and re-approved or deleted before settlement.",
      }[settlement.reason];
const rendersUnavailableSettlementPanel = shouldRenderUnavailableSettlementPanel(settlement);
---

<section
  data-monthly-balance
  data-current-membership-id={currentMembershipId}
  class:list={[
    "rounded-xl border p-4",
    hasPendingExpenses ? "border-amber-300/30 bg-amber-500/10" : "border-emerald-300/30 bg-emerald-500/10",
  ]}
>
  <p
    data-balance-heading
    class:list={["text-sm tracking-wide uppercase", hasPendingExpenses ? "text-amber-100" : "text-emerald-100"]}
  >
    Monthly balance
  </p>
  <div class="mt-3 grid gap-3 sm:grid-cols-3">
    <div>
      <p class="text-sm text-blue-100/70">Total</p>
      <p data-balance-total class="font-semibold">{balance.totalAmount.toFixed(2)} PLN</p>
    </div>
    <div>
      <p class="text-sm text-blue-100/70">Approved</p>
      <p data-balance-approved class="font-semibold">{balance.approvedAmount.toFixed(2)} PLN</p>
    </div>
    <div>
      <p class="text-sm text-blue-100/70">To review</p>
      <p data-balance-to-review class="font-semibold">{balance.toReviewAmount.toFixed(2)} PLN</p>
    </div>
  </div>
  {
    hasPendingExpenses ? (
      <p data-balance-guidance class="mt-4 text-sm text-amber-100/80">
        Some expenses are still awaiting review.
      </p>
    ) : (
      <p data-balance-guidance class="mt-4 font-medium text-emerald-100">
        {settlementMessage}
      </p>
    )
  }
  {
    rendersUnavailableSettlementPanel ? (
      <div class="mt-5 border-t border-white/10 pt-4">
        <button
          type="button"
          disabled
          title={unavailableSettlementMessage ?? undefined}
          class="cursor-not-allowed rounded-lg bg-white/10 px-4 py-2 text-sm font-medium text-blue-100/50"
        >
          Confirm settlement
        </button>
        <p class="mt-2 text-sm text-amber-100">{unavailableSettlementMessage}</p>
      </div>
    ) : settlement.kind === "eligible" ? (
      <div class="mt-5 border-t border-white/10 pt-4">
        <p class="text-sm text-emerald-100">Both parents can confirm this completed report.</p>
        <div class="mt-3">
          <SettlementConfirmationDialog month={month} paymentMessage={confirmationMessage} />
        </div>
      </div>
    ) : settlement.kind === "awaiting-other-parent" ? (
      <p class="mt-5 border-t border-white/10 pt-4 text-sm text-amber-100">
        You confirmed this settlement. The month is locked while the other parent confirms.
      </p>
    ) : settlement.kind === "requires-your-confirmation" ? (
      <div class="mt-5 border-t border-white/10 pt-4">
        <p class="text-sm text-amber-100">The other parent confirmed. Confirm the unchanged report to settle it.</p>
        <div class="mt-3">
          <SettlementConfirmationDialog month={month} paymentMessage={confirmationMessage} />
        </div>
      </div>
    ) : settlement.kind === "settled" ? (
      <div class="mt-5 border-t border-white/10 pt-4 text-sm text-emerald-100">
        <p class="font-medium">This month is settled and permanently locked.</p>
        <p>Both parents confirmed this report.</p>
        <p class="mt-1">Approved total: {settlement.approvedAmount} PLN.</p>
        <p>
          Confirmed contributions: {settlement.firstConfirmedContribution} PLN and{" "}
          {settlement.secondConfirmedContribution} PLN.
        </p>
        <p>
          {settlement.paymentFromCurrentParent === null
            ? "No payment was needed."
            : settlement.paymentFromCurrentParent
              ? `You owed ${settlement.paymentAmount} PLN.`
              : `You were owed ${settlement.paymentAmount} PLN.`}
        </p>
      </div>
    ) : null
  }
</section>
