---
import ExpenseDatePicker from "@/components/expenses/ExpenseDatePicker.astro";

interface Props {
  children: readonly { id: string; name: string }[];
  month: string;
  maxDate: string;
  defaultDate: string;
  isMonthLocked: boolean;
  lockedMessage?: string;
  serverError?: string | null;
  successBehavior?: "refresh-workspace" | "return-to-dashboard";
  successRedirectTo?: string;
  refreshFallbackRedirectTo?: string;
}

const {
  children,
  month,
  maxDate,
  defaultDate,
  isMonthLocked,
  lockedMessage,
  serverError,
  successBehavior = "refresh-workspace",
  successRedirectTo = "/dashboard?success=expense-created",
  refreshFallbackRedirectTo = "/dashboard?success=expense-created",
} = Astro.props;
---

{
  isMonthLocked ? (
    <p class="rounded-xl border border-amber-300/30 bg-amber-500/10 p-4 text-sm text-amber-100">
      {lockedMessage ?? "This month is locked while settlement is being confirmed."}
    </p>
  ) : (
    <form
      method="POST"
      action="/api/expenses/create"
      class="grid gap-3 rounded-xl border border-white/15 bg-white/5 p-4 sm:grid-cols-2"
      data-create-expense-form
      data-success-behavior={successBehavior}
      data-success-redirect-to={successRedirectTo}
      data-refresh-fallback-redirect-to={refreshFallbackRedirectTo}
    >
      <input type="hidden" name="month" value={month} />
      <label class="sm:col-span-2">
        <span class="mb-1 block text-sm text-blue-100/80">Description</span>
        <input
          name="description"
          required
          class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2"
          placeholder="e.g. School supplies"
        />
      </label>
      <label>
        <span class="mb-1 block text-sm text-blue-100/80">Child</span>
        <select name="childId" class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2">
          <option value="">No specific child</option>
          {children.map((child) => (
            <option value={child.id}>{child.name}</option>
          ))}
        </select>
      </label>
      <label>
        <span class="mb-1 block text-sm text-blue-100/80">Amount (PLN)</span>
        <input
          name="amount"
          inputmode="decimal"
          required
          class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2"
          placeholder="12,50"
        />
      </label>
      <div role="group" aria-labelledby="expense-date-label">
        <span id="expense-date-label" class="mb-1 block text-sm text-blue-100/80">
          Expense date
        </span>
        <ExpenseDatePicker month={month} maxDate={maxDate} defaultDate={defaultDate} />
      </div>
      <div class="flex items-end">
        <button
          type="submit"
          class="w-full rounded-lg bg-purple-600 px-4 py-2 font-medium hover:bg-purple-500 disabled:cursor-wait disabled:opacity-70"
        >
          Add expense
        </button>
      </div>
      {serverError && (
        <p class="sm:col-span-2" role="alert">
          {serverError}
        </p>
      )}
    </form>
  )
}

<script>
  import { refreshExpenseWorkspace } from "@/lib/expense-workspace-refresh";

  function showError(form: HTMLFormElement, message: string) {
    const existing = form?.querySelector<HTMLElement>("[role='alert']");
    if (existing) {
      existing.textContent = message;
      return;
    }
    const error = document.createElement("p");
    error.className = "sm:col-span-2 text-sm text-red-200";
    error.setAttribute("role", "alert");
    error.textContent = message;
    form.append(error);
  }

  function isValidExpenseAmount(value: FormDataEntryValue | null) {
    if (typeof value !== "string") return false;

    const amount = value.trim().replace(",", ".");
    if (!/^\d+(?:\.\d{1,2})?$/.test(amount)) return false;

    return Number(amount) > 0;
  }

  const createExpenseWindow = window as typeof window & { createExpenseSubmitHandlerReady?: boolean };

  if (!createExpenseWindow.createExpenseSubmitHandlerReady) {
    createExpenseWindow.createExpenseSubmitHandlerReady = true;
    document.addEventListener("submit", async (event) => {
      const form = event.target instanceof HTMLFormElement ? event.target : null;
      if (!form?.matches("[data-create-expense-form]")) return;

      event.preventDefault();
      const submitButton = form.querySelector<HTMLButtonElement>("button[type='submit']");
      if (!submitButton) return;

      const data = new FormData(form);
      form.querySelector("[role='alert']")?.remove();
      const amountInput = form.elements.namedItem("amount");
      if (!isValidExpenseAmount(data.get("amount"))) {
        showError(form, "Enter a positive amount with at most two decimal places.");
        if (amountInput instanceof HTMLInputElement) amountInput.focus();
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Saving…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: data,
        });
        const result = (await response.json()) as { error?: string; month?: string };
        if (!response.ok || result.error || !result.month) {
          showError(form, result.error ?? "We could not save that expense. Please try again.");
          return;
        }
        if (form.dataset.successBehavior === "return-to-dashboard") {
          window.location.assign(form.dataset.successRedirectTo ?? "/dashboard?success=expense-created");
          return;
        }
        try {
          await refreshExpenseWorkspace(window, result.month);
        } catch {
          window.location.assign(form.dataset.refreshFallbackRedirectTo ?? "/dashboard?success=expense-created");
          return;
        }
        form.reset();
        form.dispatchEvent(new CustomEvent("expense-created", { bubbles: true }));
      } catch {
        showError(form, "We could not save that expense. Please try again.");
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Add expense";
      }
    });
  }
</script>
