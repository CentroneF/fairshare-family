---
import Topbar from "@/components/Topbar.astro";
---

<main class="bg-cosmic relative min-h-screen overflow-hidden text-white">
  <div
    class="pointer-events-none absolute -top-24 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-purple-500/20 blur-[120px]"
  >
  </div>
  <div class="pointer-events-none absolute top-1/3 -left-24 h-72 w-72 rounded-full bg-blue-500/15 blur-[120px]"></div>
  <div class="pointer-events-none absolute right-0 bottom-0 h-80 w-80 rounded-full bg-indigo-400/10 blur-[140px]"></div>
  <div
    class="pointer-events-none absolute inset-0 opacity-70"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.12) 1px, transparent 1px); background-size: 120px 120px;"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 py-4 sm:px-8 sm:py-8">
    <Topbar />

    <section class="grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:py-28">
      <div>
        <p class="mb-5 text-sm font-semibold tracking-[0.2em] text-purple-200 uppercase">FairShare for co-parents</p>
        <h1 class="max-w-3xl text-4xl leading-tight font-bold sm:text-5xl lg:text-6xl">
          Shared family expenses, <span class="text-purple-200">without the monthly guesswork.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-blue-100/75 sm:text-xl">
          Record children’s expenses, review them together, and see a clear monthly balance for your family.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/auth/signup"
            class="inline-flex items-center justify-center rounded-lg bg-purple-500 px-6 py-3 font-semibold text-white transition hover:bg-purple-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-200"
          >
            Sign up free
          </a>
          <a
            href="/auth/signin"
            class="inline-flex items-center justify-center rounded-lg border border-white/20 px-6 py-3 font-semibold text-white transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-200"
          >
            Sign in
          </a>
        </div>
        <p class="mt-4 text-sm text-blue-100/55">Built for two co-parents sharing one family budget.</p>
      </div>

      <div
        class="rounded-2xl border border-white/15 bg-slate-950/55 p-4 shadow-2xl shadow-indigo-950/50 backdrop-blur-xl sm:p-6"
      >
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
          <div>
            <p class="text-xs font-medium tracking-wider text-blue-100/55 uppercase">July 2026</p>
            <h2 class="mt-1 text-lg font-semibold">Family summary</h2>
          </div>
          <span class="rounded-full bg-amber-300/15 px-3 py-1 text-xs font-semibold text-amber-200">2 to review</span>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-3">
          <div class="rounded-xl bg-white/8 p-4">
            <p class="text-xs text-blue-100/60">Approved expenses</p>
            <p class="mt-1 text-2xl font-bold">1,248 zł</p>
          </div>
          <div class="rounded-xl bg-white/8 p-4">
            <p class="text-xs text-blue-100/60">Waiting for review</p>
            <p class="mt-1 text-2xl font-bold">186 zł</p>
          </div>
        </div>
        <div class="mt-4 rounded-xl border border-purple-300/20 bg-purple-400/10 p-4">
          <p class="text-sm text-purple-100">Current balance</p>
          <p class="mt-1 text-xl font-semibold">Alex is owed 124 zł</p>
          <p class="mt-1 text-sm text-purple-100/65">Based on approved expenses, split equally.</p>
        </div>
        <div class="mt-5 space-y-3">
          <div class="flex items-center justify-between text-sm">
            <span class="text-blue-100/80">School supplies</span><span class="font-semibold">248 zł</span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-blue-100/80">Dentist visit</span><span class="font-semibold">320 zł</span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-blue-100/80">Summer camp</span><span class="font-semibold">680 zł</span>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="benefits-heading" class="py-12 sm:py-16">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold tracking-[0.2em] text-purple-200 uppercase">A calmer way to coordinate</p>
        <h2 id="benefits-heading" class="mt-3 text-3xl font-bold sm:text-4xl">
          Everything you need to stay on the same page.
        </h2>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <article class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <p class="text-sm font-semibold text-purple-200">01</p>
          <h3 class="mt-4 text-xl font-semibold">Record shared costs</h3>
          <p class="mt-3 leading-relaxed text-blue-100/65">
            Add an expense with its amount, description, and the child it relates to.
          </p>
        </article>
        <article class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <p class="text-sm font-semibold text-purple-200">02</p>
          <h3 class="mt-4 text-xl font-semibold">Review together</h3>
          <p class="mt-3 leading-relaxed text-blue-100/65">
            Each parent can approve or decline the other parent’s expenses before they affect the balance.
          </p>
        </article>
        <article class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <p class="text-sm font-semibold text-purple-200">03</p>
          <h3 class="mt-4 text-xl font-semibold">See the monthly picture</h3>
          <p class="mt-3 leading-relaxed text-blue-100/65">
            Review approved and pending totals, past reports, and the amount needed to settle fairly.
          </p>
        </article>
      </div>
    </section>

    <section aria-labelledby="workflow-heading" class="py-12 sm:py-16">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl sm:p-10">
        <p class="text-sm font-semibold tracking-[0.2em] text-purple-200 uppercase">How it works</p>
        <h2 id="workflow-heading" class="mt-3 text-3xl font-bold sm:text-4xl">A simple shared monthly rhythm.</h2>
        <ol class="mt-8 grid gap-6 md:grid-cols-3">
          <li>
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-purple-400 font-bold text-slate-950"
              >1</span
            ><h3 class="mt-4 text-lg font-semibold">Create your family</h3><p class="mt-2 text-blue-100/65">
              Invite the other parent with a simple join code.
            </p>
          </li>
          <li>
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-purple-400 font-bold text-slate-950"
              >2</span
            ><h3 class="mt-4 text-lg font-semibold">Add and review expenses</h3><p class="mt-2 text-blue-100/65">
              Keep each cost visible and confirm it together.
            </p>
          </li>
          <li>
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-purple-400 font-bold text-slate-950"
              >3</span
            ><h3 class="mt-4 text-lg font-semibold">Settle with clarity</h3><p class="mt-2 text-blue-100/65">
              Use the monthly balance to agree what is owed, then lock the report together.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section class="pt-8 pb-14 text-center sm:pb-20">
      <h2 class="text-3xl font-bold sm:text-4xl">Make the next monthly review easier.</h2>
      <p class="mx-auto mt-4 max-w-xl text-blue-100/70">Start a shared, clear record of your family expenses today.</p>
      <a
        href="/auth/signup"
        class="mt-7 inline-flex items-center justify-center rounded-lg bg-purple-500 px-6 py-3 font-semibold text-white transition hover:bg-purple-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-200"
      >
        Create your account
      </a>
    </section>
  </div>
</main>
