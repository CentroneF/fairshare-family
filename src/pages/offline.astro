---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0a0e1a" />
    <title>You're offline | FairShare Family</title>
  </head>
  <body>
    <main>
      <a class="brand" href="/">FairShare Family</a>
      <section aria-labelledby="offline-title">
        <p class="eyebrow">Connection needed</p>
        <h1 id="offline-title">You're offline</h1>
        <p>
          FairShare needs an internet connection to show current family, expense, and report information. No account
          data is available offline.
        </p>
        <div class="actions">
          <button type="button" onclick="window.location.reload()">Try again</button>
          <a href="/">Go to home</a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    color: #f5f3ff;
    background: linear-gradient(to bottom, #0a0e1a, #0f1529, #0a0e1a);
    font-family: system-ui, sans-serif;
  }

  main {
    display: grid;
    min-height: 100vh;
    place-content: center;
    gap: 2rem;
    padding: 2rem;
  }

  .brand {
    color: #c4b5fd;
    font-weight: 700;
    text-decoration: none;
  }

  section {
    max-width: 34rem;
    padding: 2rem;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 1rem;
    background: rgb(255 255 255 / 8%);
  }

  .eyebrow {
    margin: 0;
    color: #bfdbfe;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2rem, 6vw, 3rem);
  }

  section > p:not(.eyebrow) {
    margin: 0;
    color: #dbeafe;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  button,
  .actions a {
    border: 0;
    border-radius: 0.5rem;
    padding: 0.7rem 1rem;
    color: #0a0e1a;
    background: #e9d5ff;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .actions a {
    color: #e9d5ff;
    background: transparent;
    outline: 1px solid #c4b5fd;
  }

  button:focus-visible,
  .actions a:focus-visible,
  .brand:focus-visible {
    outline: 3px solid #bfdbfe;
    outline-offset: 3px;
  }
</style>
