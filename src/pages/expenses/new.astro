---
import CreateExpenseForm from "@/components/expenses/CreateExpenseForm.astro";
import Layout from "@/layouts/Layout.astro";
import { isAccessibleHistoricalReportMonth, loadExpenseWorkspaceState } from "@/lib/expense-balance";
import { resolveOnboardingState } from "@/lib/family-onboarding";

const { supabase, user } = Astro.locals;
const onboarding = supabase && user ? await resolveOnboardingState(supabase, user.id) : { kind: "no-family" as const };

if (onboarding.kind === "no-family" || !supabase || !user) {
  return Astro.redirect("/dashboard");
}

const currentMonth = new Date().toISOString().slice(0, 7);
const month = Astro.url.searchParams.get("month") ?? currentMonth;
if (month !== currentMonth) {
  if (onboarding.kind !== "two-parent-family") {
    return Astro.redirect("/dashboard");
  }
  if (!isAccessibleHistoricalReportMonth(month, currentMonth)) {
    return Astro.redirect("/reports");
  }
}
const today = new Date().toISOString().slice(0, 10);
const state = await loadExpenseWorkspaceState(supabase, { familyId: onboarding.family.id, userId: user.id, month });
const returnHref = month === currentMonth ? "/dashboard" : `/reports/${month}`;
const successRedirectTo =
  month === currentMonth ? "/dashboard?success=expense-created" : `/reports/${month}?success=expense-created`;
const defaultDate = today.slice(0, 7) === month ? today : `${month}-01`;
---

<Layout title="Add expense">
  <main class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
    <section class="mx-auto w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl sm:p-8">
      <a href={returnHref} class="inline-flex rounded-lg border border-white/20 px-3 py-2 text-sm hover:bg-white/10"
        >← Back</a
      >
      <p class="mt-8 text-sm tracking-wide text-purple-200 uppercase">{onboarding.family.name}</p>
      <h1 class="mt-1 text-2xl font-bold">Add expense</h1>
      <p class="mt-2 text-sm text-blue-100/70">Add an expense for {month}.</p>
      <div class="mt-6">
        <CreateExpenseForm
          children={onboarding.family.children}
          month={month}
          maxDate={today}
          defaultDate={defaultDate}
          isMonthLocked={state.settlement.isLocked}
          successBehavior="return-to-dashboard"
          successRedirectTo={successRedirectTo}
        />
      </div>
    </section>
  </main>
</Layout>
